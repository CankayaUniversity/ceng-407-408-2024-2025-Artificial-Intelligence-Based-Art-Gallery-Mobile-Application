<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/modern_indigo" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="@color/glass_white_30" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/modern_violet" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="@color/glass_white_30" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/modern_purple" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="@color/glass_black_20" />
        </shape>
    </item>
</selector>