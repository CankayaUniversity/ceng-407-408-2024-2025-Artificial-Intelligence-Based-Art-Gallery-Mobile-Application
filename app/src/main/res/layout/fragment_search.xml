<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gallery_white"
    tools:context=".fragments.SearchFragment">

    <!-- Modern gradient overlay for depth -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/glass_black_10" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:id="@+id/app_bar_layout_search">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/search_toolbar"
            android:layout_height="70dp"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Modern search icon with gallery aesthetics -->
                <ImageView
                    android:id="@+id/searchfragment_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.9"
                    android:src="@drawable/search"
                    app:tint="@color/black" />

                <!-- Gallery-style search container -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_toEndOf="@id/searchfragment_icon"
                    android:layout_toStartOf="@+id/filter_container"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/modern_search_bg"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:elevation="2dp">

                    <EditText
                        android:id="@+id/searchitem"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/gallery_black"
                        android:textColorHint="@color/glass_black_30"
                        android:hint="Discover Artists &amp; Artworks"
                        android:inputType="text"
                        android:background="@null"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-light" />

                    <!-- Elegant divider -->
                    <View
                        android:id="@+id/divider"
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/glass_black_20" />

                </LinearLayout>

                <!-- Modern filter container with rounded background -->
                <LinearLayout
                    android:id="@+id/filter_container"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/modern_spinner_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:elevation="2dp"
                    android:minWidth="100dp">

                    <!-- Filter icon -->
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_filter"
                        android:tint="@color/art_platinum"
                        android:alpha="0.7"
                        android:layout_marginEnd="8dp" />

                    <!-- Modern spinner with transparent background -->
                    <Spinner
                        android:id="@+id/filter_spinner"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:spinnerMode="dropdown"
                        android:background="@android:color/transparent"
                        android:dropDownWidth="180dp" />

                    <!-- Dropdown arrow -->
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        android:alpha="0.6"
                        android:layout_marginStart="4dp"
                        app:tint="@color/gallery_black" />

                </LinearLayout>

            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Modern gallery-style search results container -->
    <LinearLayout
        android:id="@+id/search_results_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/app_bar_layout_search"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="12dp">

        <!-- Artists Section Header with modern typography -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FEATURED ARTISTS"
                android:textColor="@color/gallery_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:alpha="0.9"
                android:fontFamily="sans-serif-medium" />

            <!-- Modern accent line -->
            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@color/modern_purple"
                android:alpha="0.7" />

        </LinearLayout>

        <!-- Artists RecyclerView with gallery card styling -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:maxHeight="160dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipToPadding="false" />

        <!-- Elegant section divider with gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/glass_black_15"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp" />

        <!-- Artworks Section Header with modern styling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GALLERY COLLECTION"
                android:textColor="@color/gallery_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:alpha="0.9"
                android:fontFamily="sans-serif-medium" />

            <!-- Modern accent line -->
            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@color/modern_teal"
                android:alpha="0.7" />

        </LinearLayout>

        <!-- Dynamic gallery-style artwork grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_user_posts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:overScrollMode="never" />

    </LinearLayout>

    <!-- Main modern gallery grid with dynamic layout -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_all_posts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/app_bar_layout_search"
        android:visibility="visible"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never" />

    <!-- Modern floating action button with gallery aesthetics -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/toggle_view_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:backgroundTint="@color/modern_purple"
        android:src="@drawable/search"
        app:fabSize="normal"
        app:tint="@color/gallery_white"
        app:elevation="8dp"
        app:borderWidth="0dp"
        app:rippleColor="@color/glass_white_30" />

</RelativeLayout>